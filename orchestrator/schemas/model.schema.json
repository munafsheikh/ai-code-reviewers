{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "acr.model/v1",
  "title": "Model manifest (models/registry/*.toml)",
  "type": "object",
  "required": ["id", "interface", "family", "tier", "status", "license", "source", "integrity", "limits", "resources", "capabilities"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "interface": {"enum": ["acr.model/v1"]},
    "family": {"type": "string"},
    "tier": {"enum": ["small", "large"]},
    "status": {"enum": ["candidate", "approved", "deprecated", "rejected"]},
    "license": {"type": "string"},
    "license_url": {"type": "string", "pattern": "^https://"},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "object", "required": ["runtime", "ref", "url"], "properties": {
      "runtime": {"enum": ["ollama", "llama-cpp", "cli"]}, "ref": {"type": "string"},
      "url": {"type": "string", "pattern": "^https://"}, "upstream": {"type": "string", "pattern": "^https://"}}},
    "integrity": {"type": "object", "required": ["algorithm", "digest"], "properties": {
      "algorithm": {"enum": ["sha256"]}, "digest": {"type": "string", "pattern": "^(|(sha256:)?[0-9a-f]{12,64})$"}}},
    "limits": {"type": "object", "required": ["context_tokens"], "properties": {"context_tokens": {"type": "integer", "minimum": 512}}},
    "resources": {"type": "object", "required": ["min_ram_mb", "recommended_ram_mb", "disk_mb", "gpu"], "properties": {
      "min_ram_mb": {"type": "integer", "minimum": 0}, "recommended_ram_mb": {"type": "integer", "minimum": 0},
      "disk_mb": {"type": "integer", "minimum": 0}, "gpu": {"enum": ["none", "optional", "required"]}}}
  }
}
