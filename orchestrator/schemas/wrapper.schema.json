{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "acr.wrapper/v1",
  "title": "Wrapper manifest (wrappers/**/wrapper.toml)",
  "type": "object",
  "required": ["id", "interface", "version", "description", "entrypoint", "license", "permissions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "interface": {"enum": ["acr.wrapper/v1"]},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string"},
    "entrypoint": {"type": "string", "pattern": "^[\\w.-]+\\.py:[A-Za-z_]\\w*$"},
    "license": {"type": "string"},
    "permissions": {"type": "object", "required": ["network", "subprocess", "filesystem"], "additionalProperties": false, "properties": {
      "network": {"enum": ["none", "allowlist"]}, "subprocess": {"type": "boolean"}, "filesystem": {"enum": ["none", "read", "read-write"]}}},
    "defaults": {"type": "object"}
  }
}
