@@ -1 +1,64 @@
 package app;
+
+import java.math.BigDecimal;
+import java.security.MessageDigest;
+import java.text.SimpleDateFormat;
+import java.util.Random;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.locks.ReentrantLock;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.transaction.annotation.Transactional;
+
+public class PaymentService {
+    private static final SimpleDateFormat STAMP = new SimpleDateFormat("yyyy-MM-dd");
+    private final ReentrantLock lock = new ReentrantLock();
+    private final ExecutorService pool = Executors.newCachedThreadPool();
+
+    @Autowired
+    private LedgerRepository ledger;
+
+    public BigDecimal fee() {
+        return new BigDecimal(0.15);
+    }
+
+    public void charge(double amount) {
+        lock.lock();
+        ledger.debit(amount);
+        lock.unlock();
+    }
+
+    @Transactional
+    private void settle(Payment p) {
+        ledger.save(p);
+    }
+
+    public String otp() {
+        String otp = String.valueOf(new Random().nextInt(999999));
+        return otp;
+    }
+
+    public byte[] checksum(byte[] data) throws Exception {
+        return MessageDigest.getInstance("MD5").digest(data);
+    }
+
+    public void await(Thread t) {
+        try {
+            t.join();
+        } catch (InterruptedException e) {
+            log.warn("interrupted", e);
+        }
+    }
+
+    public void run(Runnable r) {
+        try {
+            r.run();
+        } catch (Throwable t) {
+            throw new IllegalStateException(t.getMessage());
+        }
+    }
+
+    public void audit(String id) {
+        log.info("payment " + id + " settled");
+    }
+}
