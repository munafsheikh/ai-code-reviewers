# Copy to .env and adjust. Every variable is optional. Never put secrets in this file.
# Full reference: docs/generated/configuration.md

# Profile: fast | balanced | deep | offline   (legacy = Firefly ReviewGate compatibility)
ACR_PROFILE=balanced

# Models (registry id from models/registry or a raw runtime ref)
ACR_SMALL_MODEL=qwen2.5-coder-1.5b
ACR_LARGE_MODEL=qwen2.5-coder-7b
# Runtime refs pulled by the model-init service (space separated)
ACR_PULL_MODELS=qwen2.5-coder:1.5b

# Model runtime (must be loopback, a compose service name, or listed in ACR_ALLOWED_HOSTS)
ACR_MODEL_HOST=http://llm-runtime:11434
# LLM_RUNTIME_IMAGE=ollama/ollama:0.40.11@sha256:dea72d1e22270fe095b68fdf756d2b489d615643c5a2eaebbc5f569181e322d8
ACR_ALLOWED_HOSTS=

# Directory mounted read-only at /work inside the reviewer container
ACR_WORKDIR=./examples

# Resource limits
ACR_CPUS=1.0
ACR_MEMORY=512m
LLM_CPUS=4.0
LLM_MEMORY=6g
ACR_HOST_PORT=8088
ACR_MAX_CONCURRENT_REVIEWS=2
